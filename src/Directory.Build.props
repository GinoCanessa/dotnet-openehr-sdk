<Project>

  <!--
    All projects under src/ are shipping NuGet packages. Set this flag
    BEFORE importing the parent Directory.Build.props so the parent's
    AOT/trim and package-metadata groups (which are gated on
    _IsShippingProject == 'true') actually apply.
  -->
  <PropertyGroup>
    <_IsShippingProject>true</_IsShippingProject>
  </PropertyGroup>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    Single-read, UTC build timestamp. All shipping-package version
    properties below derive from this one capture so VersionPrefix,
    AssemblyVersion, and FileVersion cannot disagree across an HHmm
    boundary within a single csproj evaluation. Format is preserved
    from the original src/common.props spec; NuGet/SemVer 2.0.0 will
    normalize leading zeros in the package version segments on disk
    and on nuget.org (e.g. 2026.0603.0812 -> 2026.603.812).
    AssemblyVersion is unaffected by that normalization because it is
    a fixed 4-part integer tuple.
  -->
  <PropertyGroup Label="Version">
    <_BuildTimestampUtc>$([System.DateTime]::UtcNow.ToString("yyyy.MMdd.HHmm"))</_BuildTimestampUtc>
    <VersionPrefix>$(_BuildTimestampUtc)</VersionPrefix>
    <Version>$(VersionPrefix)-beta.0</Version>
    <AssemblyVersion>0.$(_BuildTimestampUtc)</AssemblyVersion>
    <FileVersion>0.$(_BuildTimestampUtc)</FileVersion>
  </PropertyGroup>

</Project>
