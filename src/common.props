<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <!-- Solution-wide properties -->
    <PropertyGroup>
        <LangVersion>14.0</LangVersion>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>$(AssemblyName.Replace(' ', '_'))</AssemblyName>
		<Authors>GinoCanessa</Authors>
		<Company>Gino Canessa</Company>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
	    <PackageReadmeFile>README.md</PackageReadmeFile>
        <Copyright>Copyright 2026+</Copyright>
        <PackageProjectUrl>https://github.com/ginoc/dotnet-openehr-sdk</PackageProjectUrl>
        <RepositoryUrl>https://github.com/ginoc/dotnet-openehr-sdk</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
		<NeutralLanguage>en</NeutralLanguage>
        <PackageTags>openehr ehr health interoperability</PackageTags>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <NoWarn>$(NoWarn);</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\">
			<Link>LICENSE</Link>
		</None>
		<None Include="..\..\README.md" Pack="true" PackagePath="\">
			<Link>README.md</Link>
		</None>
	</ItemGroup>

</Project>
