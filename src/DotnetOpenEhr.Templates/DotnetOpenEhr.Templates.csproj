<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\common.props" />

  <PropertyGroup>
    <RootNamespace>DotnetOpenEhr.Templates</RootNamespace>
    <AssemblyName>DotnetOpenEhr.Templates</AssemblyName>
    <PackageId>DotnetOpenEhr.Templates</PackageId>
    <Description>
      openEHR Operational Template parser and concrete OperationalTemplate
      model for .NET. Reads both OPT2 (ADL2-text via Opt2Parser, on top of
      the ADL2 parser from DotnetOpenEhr.Archetypes) and OPT1.4 (XML via
      Opt14XmlParser, the format every authoring tool emits — CKM, Better
      Studio, EHRbase, openFHIR KDS). Both parsers return the same
      OperationalTemplate, so the ITemplateSchema seam consumed by the
      template-aware FLAT serializer and the validator works uniformly
      across formats. Trim-safe and Native-AOT-safe. Single TFM net10.0.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotnetOpenEhr.Foundation\DotnetOpenEhr.Foundation.csproj" />
    <ProjectReference Include="..\DotnetOpenEhr.Odin\DotnetOpenEhr.Odin.csproj" />
    <ProjectReference Include="..\DotnetOpenEhr.Rm\DotnetOpenEhr.Rm.csproj" />
    <ProjectReference Include="..\DotnetOpenEhr.Archetypes\DotnetOpenEhr.Archetypes.csproj" />
    <ProjectReference Include="..\DotnetOpenEhr.Bmm\DotnetOpenEhr.Bmm.csproj" />
    <ProjectReference Include="..\DotnetOpenEhr.Bmm.Rm\DotnetOpenEhr.Bmm.Rm.csproj" />
    <ProjectReference Include="..\DotnetOpenEhr.Templates.Abstractions\DotnetOpenEhr.Templates.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotnetOpenEhr.Templates.Tests" />
  </ItemGroup>

</Project>
