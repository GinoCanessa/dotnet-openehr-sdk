<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DotnetOpenEhr.Odin</RootNamespace>
    <AssemblyName>DotnetOpenEhr.Odin</AssemblyName>
    <PackageId>DotnetOpenEhr.Odin</PackageId>
    <Description>
      Standalone, hand-written ODIN (Object Data Instance Notation) parser,
      AST, and writer for the openEHR DotnetOpenEhr SDK. ODIN is the
      attribute/object notation used inside ADL2 archetypes and templates.
      Trim-safe and Native-AOT-safe. Single TFM net10.0.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotnetOpenEhr.Foundation\DotnetOpenEhr.Foundation.csproj" />
  </ItemGroup>

</Project>
