description
    lifecycle_state = <"unmanaged">
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"M4 fixture: pin that an external binding on a CTerminologyCode takes precedence over the local value-set. The composition uses a code not in the local value-set; without precedence the validator would emit TERM_001 Error, but the binding must override that to BINDING_001 NotValidated.">
        >
    >

