        content matches {
            OBSERVATION[id1] occurrences matches {1..1} matches {
                data matches {
                    HISTORY[id2] matches {
                        events cardinality matches {0..1} matches {
                            POINT_EVENT[id3] occurrences matches {0..*} matches {
                                data matches {
                                    ITEM_TREE[id4] matches {
                                        items matches {
                                            ELEMENT[id7] occurrences matches {0..1} matches {
                                                value matches {
                                                    DV_CODED_TEXT[id8] matches {
                                                        defining_code matches {[ac1]}
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

